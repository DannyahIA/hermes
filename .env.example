# Postgres connection string. For local development, run `docker compose up -d`
# and use the value below (matches docker-compose.yml).
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes

# Optional: a pooled connection string (e.g. PgBouncer/Supabase pooler) for
# serverless deployments. Falls back to DATABASE_URL when unset.
DATABASE_POOL_URL=

# Secret used by better-auth to sign sessions/tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app (used for auth callbacks and links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enables "Continuar com GitHub" when both are set.
# Create at https://github.com/settings/developers — callback URL:
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: enables "Continuar com Google" when both are set.
# Create at https://console.cloud.google.com/apis/credentials — callback URL:
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, dev-only: lets `next dev` be reached from another device on your
# LAN (e.g. testing on a phone) without its HMR origin protection blocking
# requests. Comma-separated list of hostnames/IPs, e.g. 192.168.1.42. Not
# used in production.
NEXT_DEV_ALLOWED_ORIGINS=

# Optional: sends real verification/password-reset emails via Resend
# (https://resend.com/api-keys). Without it, those emails are logged to the
# server console instead — useful for local development.
RESEND_API_KEY=
# Sender address emails are sent from. Resend's shared test domain works
# without verifying your own domain, but only delivers to your own account's
# email while unverified.
EMAIL_FROM="Hermes <onboarding@resend.dev>"
